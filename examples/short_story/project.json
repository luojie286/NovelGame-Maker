  "title": "晨光回声",
  "start_node_id": "b2318c14-9f26-5cdb-87d6-3c5d461bba49",
  "nodes": [
    {
      "id": "b2318c14-9f26-5cdb-87d6-3c5d461bba49",
      "name": "旧车站",
      "items": [
        {
          "id": "92ddb3a2-c147-5583-8f8d-29ae2cfb2760",
          "type": "set_background",
          "asset_id": "76f5cd30-d737-59f0-a68d-278dd4a1eaef"
        },
        {
          "id": "10a4f313-b7d9-5512-a4b6-2fe309d57e4a",
          "type": "play_bgm",
          "asset_id": "ab3b3a9c-9295-5af5-84a2-6fe706b34062"
        },
        {
          "id": "0ad67a47-fb6b-599a-a065-3b3fb329d41d",
          "type": "play_sfx",
          "asset_id": "c66a1889-56f0-55d7-85e1-38db7df1216e"
        },
        {
          "id": "04936626-b252-59fc-a5d5-16b616452e3b",
          "type": "show_sprite",
          "asset_id": "9ffdea35-2615-50c7-8b5e-c902a6fcaa19",
          "slot": "left"
        },
        {
          "id": "4c4694e5-fc02-5e0c-8cd7-cb3b59075d54",
          "type": "dialogue",
          "character_id": "fe0451c5-e3d4-5d56-86c9-8e0846fd4cb9",
          "text": "钟楼的灯灭了，整座城只剩下旧车站的一盏灯。"
        },
        {
          "id": "0bd63775-b612-5800-b8c7-3fe7426ba2fd",
          "type": "narration",
          "text": "遥带着一封未寄出的信，走进夜色。"
        }
      ]
    },
    {
      "id": "b635baa0-dd3c-52aa-89ba-42598bef4760",
      "name": "去留",
      "items": [
        {
          "id": "d4ecb1d1-a29c-5122-bf78-b3a49036fb64",
          "type": "show_sprite",
          "asset_id": "646f026a-d1fb-51a7-b48e-48fb53339d0a",
          "slot": "right"
        },
        {
          "id": "c80588bf-54eb-5d29-b3aa-8ec80a80f1b6",
          "type": "dialogue",
          "character_id": "8db130f9-84fd-5aed-b927-043f7676a6dc",
          "text": "天亮之前，你愿意听我说完吗？"
        }
      ],
      "choices": [
        {
          "id": "bcfb1660-472c-5b24-89c5-4125980a1284",
          "text": "留下听她说"
        },
        {
          "id": "f58fe843-fe38-595c-bf3d-1c525da5ca72",
          "text": "转身离开"
        }
      ]
    },
    {
      "id": "1279efcb-3e94-5f92-bf3e-700d4a752f73",
      "name": "留下",
      "items": [
        {
          "id": "d52c1daf-a185-5560-949e-d411e7fca1b5",
          "type": "dialogue",
          "character_id": "fe0451c5-e3d4-5d56-86c9-8e0846fd4cb9",
          "text": "我会等到钟声再响。"
        }
      ]
    },
    {
      "id": "9723ca1b-15aa-5c26-80a1-0fcb70ac72a0",
      "name": "离开",
      "items": [
        {
          "id": "e5276a84-fe08-5064-8660-897a82e5bcbc",
          "type": "narration",
          "text": "脚步声在空旷的站台上渐渐消失。"
        }
      ]
    },
    {
      "id": "8c88f10f-c622-594c-85cd-a43331ff9b67",
      "name": "钟声",
      "items": [
        {
          "id": "efd37575-8912-5569-841d-1be115c0ca72",
          "type": "narration",
          "text": "第一缕晨光穿过玻璃，钟声终于再次响起。"
        }
      ]
    },
    {
      "id": "dd811904-ff78-5c89-b805-dad239908c45",
      "name": "晨光结局",
      "items": [
        {
          "id": "d6c92a06-aae8-5b78-ad36-a874edf794b1",
          "type": "dialogue",
          "character_id": "8db130f9-84fd-5aed-b927-043f7676a6dc",
          "text": "这封信，终于可以交给你。"
        }
      ],
      "ending": {
        "credits_video_asset_id": "adb2262b-3b9b-5ce5-bb77-faa50ee3e06a"
      }
    },
    {
      "id": "879256b9-8ff6-5120-b596-bbdc0099adc0",
      "name": "告别结局",
      "items": [
        {
          "id": "2a59ed06-0b13-5afa-86e9-830f99a4ff4f",
          "type": "narration",
          "text": "信留在了站台，等待下一次列车。"
        }
      ],
      "ending": {
        "credits_video_asset_id": null
      }
    }
  ],
